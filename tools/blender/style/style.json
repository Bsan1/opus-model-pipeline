  "near_misses": [
    {
      "variant": "glossy_plastic",
      "rule": "surfaces.painted",
      "what": "flat colour and a mirror finish: it reads as cheap plastic, not as a painted, grained surface"
    },
    {
      "variant": "oversaturated",
      "rule": "colour.albedo_gamut",
      "what": "the base colours pushed past the palette's chroma: loud against the hazy pastel frames"
    },
    {
      "variant": "baked_shadow",
      "rule": "surfaces.no_baked_light",
      "what": "a shadow gradient painted into the colour: it stays dark whatever the light does"
    },
    {
      "variant": "black_shadows",
      "rule": "colour.atmosphere",
      "what": "no sky light: neutral black shadows instead of the lavender-tinted ones of the source"
    }
  ],
