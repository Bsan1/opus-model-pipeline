  "rules": [
    {
      "id": "shape.stylised",
      "kind": "invariant",
      "check": "review",
      "text": "simple stylised shapes over scanned realism; the silhouette reads from the game camera"
    },
    {
      "id": "shape.one_shell",
      "kind": "invariant",
      "check": "qc.construction + review",
      "text": "one shell per real piece, no stacked primitives; revolved parts are one profile with details pushed out of it"
    },
    {
      "id": "shape.source_proportions",
      "kind": "invariant",
      "check": "Compare.py + review",
      "text": "proportions follow the source even when not realistic; detail at the source's scale (small tread blocks, not toy lugs)"
    },
    {
      "id": "edges.chamfer",
      "kind": "tunable",
      "check": "Style.py report (bevels_mm against chamfer_mm) + review",
      "text": "hard parts: a single-segment chamfer within stylisation.chamfer_mm, with weighted normals, so edges catch the light softly",
      "enforce": "warn"
    },
    {
      "id": "edges.soft_shells",
      "kind": "tunable",
      "check": "review",
      "text": "soft moulded shells: plain smoothing, no area weighting"
    },
    {
      "id": "surfaces.painted",
      "kind": "invariant",
      "check": "review (near miss: glossy_plastic)",
      "text": "a painted look, never flat plastic: a real CC0 grain or tone under the paint, a little tone variation per piece (4-8 %)"
    },
    {
      "id": "surfaces.materials_differ",
      "kind": "invariant",
      "check": "MATERIALS registry (opus_model) + ModelImportTests",
      "text": "different materials look different; the same paint in another colour is the same material"
    },
    {
      "id": "surfaces.grime",
      "kind": "tunable",
      "check": "review",
      "text": "grime only on concrete, brick and stone"
    },
    {
      "id": "surfaces.no_baked_light",
      "kind": "invariant",
      "check": "review (near miss: baked_shadow)",
      "text": "no lighting or shadows painted into textures"
    },
    {
      "id": "finish.real_material",
      "kind": "invariant",
      "check": "Style.py report (finish_by_kind) + review",
      "text": "the finish comes from the real material: black plastic matte, enamelled metal glossy, powder coat satin, chrome metallic, rubber and wood matte"
    },
    {
      "id": "colour.albedo_gamut",
      "kind": "invariant",
      "check": "Style.py report",
      "text": "base colours inside measured.albedo; outside only with \"style exception: <why>\" in the surface note"
    },
    {
      "id": "colour.clean_frames",
      "kind": "tunable",
      "check": "review",
      "text": "colours are sampled from clean frames; the lavender sky light tints greys, so base colours are shifted against it"
    },
    {
      "id": "colour.atmosphere",
      "kind": "invariant",
      "check": "Style.py shots (game shot against its reference) + look",
      "text": "a pastel, hazy atmosphere; mown grass lighter and brighter than unmown; no saturated sharp borders",
      "enforce": "warn"
    },
    {
      "id": "detail.guesses_simple",
      "kind": "tunable",
      "check": "plan (source guess) + review",
      "text": "what the camera cannot see stays simple and is marked as a guess"
    },
    {
      "id": "detail.floor",
      "kind": "tunable",
      "check": "review",
      "text": "nothing modelled below stylisation.detail_floor_m for its class"
    },
    {
      "id": "detail.budgets",
      "kind": "tunable",
      "check": "Style.py report (stylisation.budgets_tris)",
      "text": "triangles within stylisation.budgets_tris for the asset's class",
      "enforce": "warn"
    }
  ],
